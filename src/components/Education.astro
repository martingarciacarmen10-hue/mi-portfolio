---
const studies = [
  {
    title: "GRADO\nSUPERIOR DAW",
    date: "2025 – Actualmente",
    center: "Col. Sta. Joaquina de\nVedruna (Sevilla)"
  },
  {
    title: "BACHILLERATO",
    date: "2022 – 2025",
    center: "I.E.S. Suárez de\nFigueroa (Zafra/\nBadajoz)"
  },
  {
    title: "E.S.O.",
    date: "2018 – 2022",
    center: "Colegio María\nInmaculada (Zafra/\nBadajoz)"
  }
];
---

<section id="estudios" class="studies-section">
  <div class="studies-container">
    <div class="header">
      <span class="subtitle-top">TRAYECTORIA</span>
      <h2 class="title">DATOS ACADÉMICOS</h2>
      <p class="subtitle-bottom">Mi trayectoria en desarrollo web....</p>
    </div>

    <div class="cards-grid">
      {studies.map((item) => (
        <div class="card">
          <h3 class="card-title">{item.title}</h3>
          <p class="card-date">{item.date}</p>
          <p class="card-center">{item.center}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&display=swap');

  .studies-section {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: #cbbba9;
    padding: 2.5rem 1.5rem 3rem;
    box-sizing: border-box;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }

  .studies-container {
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }

  .header {
    margin-bottom: 2rem;
    color: #2b2621;
  }

  .subtitle-top {
    display: block;
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
    font-weight: 400;
  }

  .title {
    font-size: 2.1rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    margin: 0 0 0.2rem 0;
    color: #231f1b;
  }

  .subtitle-bottom {
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 600; /* Puesto en negrita */
    margin: 0;
    color: #332d27;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    justify-content: center;
  }

  .card {
    background-color: #fcfbf7;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 270px;
    box-sizing: border-box;
  }

  .card-title {
    color: #c4a064;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-align: center;
    margin: 0;
    white-space: pre-line;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .card-date {
    color: #2b2621;
    font-size: 1.05rem;
    margin: 0;
    letter-spacing: 0.03em;
  }

  .card-center {
    color: #2b2621;
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.3;
    white-space: pre-line;
    text-align: center;
  }

  @media (max-width: 850px) {
    .cards-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin: 0 auto;
    }

    .card {
      height: 250px;
    }
  }
</style>