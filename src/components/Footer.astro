<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap');

  .footer {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: #2b241f;
    padding: 3.5rem 2rem;
    box-sizing: border-box;
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: #c4a064; /* Dorado cálido exacto a tu imagen */
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.2fr;
    gap: 2.5rem;
    align-items: flex-start;
  }

  /* Títulos de sección */
  .col-title {
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    margin: 0 0 1.8rem 0;
    color: #c4a064;
  }

  /* Columna Izquierda: Contacto */
  .contact-item {
    font-size: 1rem;
    margin: 0 0 1.2rem 0;
    color: #c4a064;
    letter-spacing: 0.03em;
  }

  .contact-item.link {
    display: inline-block;
    color: #c4a064;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Columna Central: Marca */
  .col-center {
    text-align: center;
  }

  .brand-name {
    font-size: 2.2rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    margin: 0 0 1rem 0;
    color: #c4a064;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: #594c41;
    margin: 0 auto 1.5rem;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
  }

  .footer-nav a {
    color: #c4a064;
    text-decoration: none;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }

  .footer-nav a:hover {
    opacity: 0.8;
  }

  /* Columna Derecha: Redes */
  .social-links {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .social-item {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    color: #c4a064;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .social-item:hover {
    text-decoration: underline;
  }

  .social-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    stroke: #c4a064;
    fill: none;
  }

  .social-icon[fill="currentColor"] {
    fill: #c4a064;
    stroke: none;
  }

  .break-url {
    word-break: break-all;
    line-height: 1.25;
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }

    .social-item {
      justify-content: center;
    }
  }
</style>